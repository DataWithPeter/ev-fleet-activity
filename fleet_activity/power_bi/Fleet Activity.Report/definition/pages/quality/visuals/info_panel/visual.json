    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Trusted: the pipeline checks passed for that vehicle-day.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Untrusted, Missing telemetry and Insufficient readings days keep a blank distance (not 0 km).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Unregistered: a vehicle seen in telemetry but missing from the fleet roster. Its km is included in the totals.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Vehicle-days by day: each column is one day of vehicles. Orange is the part that needs attention.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Needs review lists every problem day plus days from vehicles missing from the fleet roster.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Fleet and telemetry are synthetic. Weather is from Open-Meteo.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#BDBDBD"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
