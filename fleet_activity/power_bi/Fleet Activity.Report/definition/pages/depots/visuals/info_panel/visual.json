    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Top left: how often each depot and model sits idle. Top right: how far they drive on the days they move.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Each dot is one registered vehicle: idle days against total distance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Km per driving day = average over trusted vehicle-days with more than 0 km.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Driving vehicle-days count trusted days above 0 km; idle days % counts trusted 0 km days divided by all trusted days. The registered-vehicle count and scatter exclude the unregistered vehicle; the leaderboard retains it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Fleet and telemetry are synthetic. Weather is from Open-Meteo.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#BDBDBD"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
