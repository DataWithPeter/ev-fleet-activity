    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Distance counts trusted vehicle-days only. Missing or untrusted distance stays blank, never zero.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Idle day: a trusted vehicle-day with 0 observed km (no distance between the available readings).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Idle days % = idle days ÷ trusted vehicle-days. It is not a fleet-wide active-vehicle rate.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Km per driving day = average over trusted vehicle-days with more than 0 km.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Daily distance and vehicles on the road move together: on days fewer vehicles drove, the fleet covered fewer km. That is partly arithmetic, not proof of cause.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Dry vs wet compares km per driving day within each depot. The synthetic activity was generated without weather, so read it as descriptive.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#E6E6E6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Fleet and telemetry are synthetic. Weather is from Open-Meteo.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#BDBDBD"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
