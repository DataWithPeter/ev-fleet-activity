model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DatabricksHost","DatabricksHttpPath","GoldSource","DimDate","DimVehicle","DimDepot","Fleet","Measures table"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Fleet
ref table 'Measures table'
ref table DimDate
ref table DimVehicle
ref table DimDepot

ref cultureInfo en-US

