table gold_vehicle_day_quality
	lineageTag: c0040775-28f1-4622-94a7-15f303f00a3a

	measure Vehicle-days = COUNTROWS(gold_vehicle_day_quality)
		formatString: #,0
		lineageTag: aa938932-2459-4c1c-91f8-c16721396f2a

	measure 'Trusted vehicle-days' = COALESCE(CALCULATE(COUNTROWS(gold_vehicle_day_quality), KEEPFILTERS(gold_vehicle_day_quality[distance_status] = "trusted")), 0)
		formatString: #,0
		lineageTag: f12da5a5-94ec-4934-96c4-e89a8f6bcc2d

	measure 'Reporting-affected vehicle-days' = CALCULATE(COUNTROWS(gold_vehicle_day_quality), KEEPFILTERS(gold_vehicle_day_quality[distance_status] <> "trusted"))
		formatString: #,0
		lineageTag: e1fa05c7-162a-41ce-8652-a681435cac04

	measure 'Held vehicle-days' = CALCULATE(COUNTROWS(gold_vehicle_day_quality), KEEPFILTERS(gold_vehicle_day_quality[distance_status] = "untrusted"))
		formatString: #,0
		lineageTag: 2777bab8-1038-4457-a855-ef71f77b4857

	measure 'Exception-bearing vehicle-days' = CALCULATE(COUNTROWS(gold_vehicle_day_quality), gold_vehicle_day_quality[issue_count] > 0)
		formatString: #,0
		lineageTag: 22b43c96-aff4-4e43-9bbb-bd2563190821

	measure 'Registry-exception vehicle-days' = CALCULATE(COUNTROWS(gold_vehicle_day_quality), gold_vehicle_day_quality[registered_vehicle] = FALSE())
		formatString: #,0
		lineageTag: e9e14361-0112-4564-ab47-0c3ffc98f19c

	measure 'Accepted readings in selection' = SUM(gold_vehicle_day_quality[accepted_reading_count])
		formatString: #,0
		lineageTag: 1eb7305b-3883-49a0-aa2c-e91aacb0cb4c

	measure 'Linked rejects in selection' = SUM(gold_vehicle_day_quality[rejected_record_count])
		formatString: #,0
		lineageTag: 8e69d41e-564f-478b-bd4a-7cc4abd7ac74

	measure 'Held readings in selection' = SUM(gold_vehicle_day_quality[held_reading_count])
		formatString: #,0
		lineageTag: f4ca34f3-e3af-48a5-8564-6041f57c9d41

	measure 'Reporting coverage' = DIVIDE([Trusted vehicle-days], [Vehicle-days])
		formatString: 0.0%
		lineageTag: 7deaffa2-d6c4-4973-9ebd-b95b1b674464

	column vehicle_day_key
