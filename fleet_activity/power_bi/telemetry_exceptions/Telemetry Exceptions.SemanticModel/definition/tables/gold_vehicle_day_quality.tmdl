		sourceColumn: primary_issue

		annotation SummarizationSetBy = Automatic

	column primary_issue_display = SWITCH(gold_vehicle_day_quality[primary_issue], "conflicting_timestamp", "Conflicting readings", "odometer_decreased", "Odometer decreased", "rejected_reading_in_day", "Rejected reading", "missing_telemetry", "No telemetry", "insufficient_readings", "Too few readings", "unregistered_vehicle", "Not in fleet roster", BLANK(), "No issue", gold_vehicle_day_quality[primary_issue])
		dataType: string
		lineageTag: 77e6fc3a-8623-4468-97e8-964d9bb9af25
		summarizeBy: none

	column distance_status_display = SWITCH(gold_vehicle_day_quality[distance_status], "trusted", "Reportable", "untrusted", "Held for review", "insufficient_readings", "Too few readings", "missing_telemetry", "No telemetry", gold_vehicle_day_quality[distance_status])
		dataType: string
		lineageTag: 44f3e917-80bc-4eb8-bb23-6f6ea55f83fd
		summarizeBy: none

